{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "prebuild": "node scripts/generate-project-images-map.js && node scripts/generate-gallery-images-map.js && node scripts/generate-gallery-images-metadata.js",
    "generate:metadata": "node scripts/generate-project-images-metadata.js && node scripts/generate-gallery-images-metadata.js",
    "audit:seo": "pnpm build && node scripts/audit-seo.js",
    "audit:schema-org": "pnpm build && node scripts/audit-schema-org.js",
    "build": "nuxt build",
    "build:netlify": "volta run --node 22.22.1 netlify build",
    "clean:dev-runtime": "rm -rf .nuxt .output .netlify/functions .netlify/functions-internal .netlify/functions-serve .netlify/netlify.toml",
    "dev": "nuxt dev",
    "dev:netlify": "netlify dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && (npx skilld prepare || true)",
    "sentry:issue-ai": "node scripts/sentry-issue-ai.js",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tests/tsconfig.json && pnpm typecheck:config",
    "typecheck:config": "vue-tsc --noEmit -p tsconfig.nuxt-config.json && vue-tsc --noEmit -p tsconfig.content-config.json",
    "lint": "NODE_OPTIONS=--no-warnings eslint .",
    "lint:fix": "NODE_OPTIONS=--no-warnings eslint . --fix",
    "lint:md": "remark . --use remark-preset-lint-recommended --quiet",
    "format:md": "remark . --output --quiet",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "sync:pnpm": "node scripts/sync-pnpm-version.js",
    "check:pnpm": "node scripts/sync-pnpm-version.js --check",
    "check": "pnpm check:pnpm && pnpm typecheck && pnpm lint && pnpm test:unit",
    "prepare": "husky && (npx skilld prepare || true)"
  },
  "dependencies": {
    "@intlify/shared": "^11.4.8",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@sentry/nuxt": "^10.70.0",
    "@takumi-rs/core": "2.10.0",
    "better-sqlite3": "^12.11.1",
    "lightgallery": "^2.9.0",
    "minisearch": "^7.2.0",
    "nuxt": "^4.5.2",
    "nuxt-gtag": "5.0.0",
    "ogl": "^1.0.11",
    "pixi.js": "^8.19.0",
    "reka-ui": "^2.10.3",
    "shiki": "~4.4.3",
    "simplex-noise": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@barzhsieh/nuxt-content-mermaid": "3.0.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@formkit/auto-animate": "^0.10.0",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/lucide": "^1.2.124",
    "@iconify-json/material-symbols-light": "^1.2.89",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify-json/vscode-icons": "^1.2.74",
    "@netlify/nuxt": "^0.3.9",
    "@nuxt/content": "^3.15.2",
    "@nuxt/icon": "^2.5.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxtjs/html-validator": "^2.1.0",
    "@nuxtjs/mdc": "^0.23.1",
    "@nuxtjs/robots": "6.1.4",
    "@nuxtjs/seo": "^5.3.12",
    "@nuxtjs/sitemap": "8.3.4",
    "@stefanobartoletti/nuxt-social-share": "^3.2.0",
    "@unocss/eslint-plugin": "^66.8.0",
    "@unocss/nuxt": "^66.8.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "dayjs": "^1.11.23",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "lint-staged": "^17.3.0",
    "nuxt-delay-hydration": "^1.3.8",
    "nuxt-headlessui": "^1.2.2",
    "nuxt-llms": "^0.2.0",
    "nuxt-og-image": "6.7.8",
    "nuxt-schema-org": "6.2.9",
    "nuxtseo-layer-devtools": "^5.3.12",
    "remark-validate-links": "^13.1.0",
    "sass": "^1.102.0",
    "sentry": "0.42.2",
    "sharp": "^0.35.3",
    "swiper": "^14.1.0",
    "typescript": "^6.0.3",
    "unocss": "^66.8.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix"
  },
  "volta": {
    "node": "22.22.1"
  }
}
